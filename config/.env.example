# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitness_warehouse
DB_USER=your_username
DB_PASSWORD=your_password

# Strava (in use)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Planned sources (not used yet)
# Apple Health needs no key: you export your data from the Health app on your iPhone.
# MyFitnessPal is for nutrition tracking only.
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret
GARMIN_CLIENT_ID=your_garmin_client_id
GARMIN_CLIENT_SECRET=your_garmin_client_secret
